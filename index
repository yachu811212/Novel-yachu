function show(i,anim){cur=i;document.querySelectorAll("#tabs button").forEach((b,j)=>b.setAttribute("aria-selected",j==i));
const d=DAYS[i];
$("#panel").innerHTML=`<div class="dhead"><svg viewBox="0 0 84 66" stroke="#3E3A39" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">${ICO[d.ico]}</svg><h3>${d.d}｜${d.title}</h3></div><ul class="tl">${d.items.map(x=>{const g=TAGS[x[3]];return `<li class="${x[4]?"m":""}"><div class="tm">${x[0]}</div><div class="tt"><span class="tag ${g[1]}">${g[0]}</span>${x[1]}${x[4]?'<span class="must">必去</span>':""}</div>${x[2]?`<div class="ds">${x[2]}</div>`:""}</li>`}).join("")}</ul><div class="meal">🍴 ${d.meal}</div><p style="font-size:14px;margin-top:8px">🛏 夜宿：${i<2?"澎澄飯店 Discovery Hotel":"溫馨返家"}</p>`;
const p=$("#panel");p.classList.remove("pop");if(anim){void p.offsetWidth;p.classList.add("pop")}}
$("#tabs").onclick=e=>{const b=e.target.closest("button");if(b)show(+b.dataset.i,true)};
show(0,false);
function bar(key,total){const s=store.get("pg-"+key);const n=Object.values(s).filter(Boolean).length;$("#p-"+key).style.width=(n/total*100)+"%"}
function mk(key,items,host,total){const s=store.get("pg-"+key);
return items.map((t,i)=>`<li><label><input type="checkbox" data-k="${key}" data-i="${t}" ${s[t]?"checked":""}><span>${t}</span></label></li>`).join("")}
$("#l-todo").innerHTML=mk("todo",LISTS.todo);
$("#l-before").innerHTML=mk("before",LISTS.before);
const packAll=Object.values(PACK).flat();
$("#l-pack").innerHTML=Object.entries(PACK).map(([g,a])=>`<div class="grp"><h3>${g}</h3><ul class="list">${mk("pack",a)}</ul></div>`).join("");
const totals={todo:LISTS.todo.length,before:LISTS.before.length,pack:packAll.length};
Object.keys(totals).forEach(k=>bar(k,totals[k]));
document.addEventListener("change",e=>{const c=e.target;if(!c.dataset.k)return;const s=store.get("pg-"+c.dataset.k);s[c.dataset.i]=c.checked;store.set("pg-"+c.dataset.k,s);bar(c.dataset.k,totals[c.dataset.k])});
</script>
</body>
</html>

