.tag{display:inline-block;font-size:12px;border:2px solid var(--ink);border-radius:999px;padding:0 8px;margin-right:4px;vertical-align:middle}
.t-fly,.t-boat{background:var(--sea)}.t-car{background:var(--sun)}.t-walk{background:var(--green)}.t-eat{background:var(--coral)}.t-hotel{background:var(--paper)}
.must{background:var(--coral);color:var(--ink);font-size:12px;border:2px solid var(--ink);border-radius:8px;padding:0 6px;display:inline-block;transform:rotate(-4deg);margin-left:4px}
.tabs{display:flex;gap:8px}
.tabs button{flex:1;font:inherit;color:var(--ink);background:var(--paper);border:3px solid var(--ink);border-radius:20px;padding:6px 4px;cursor:pointer;line-height:1.3}
.tabs button small{display:block;font-size:12px}
.tabs button[aria-selected=true]{background:var(--sun);transform:translateY(-2px);box-shadow:0 4px 0 var(--ink)}
.panel{margin-top:14px}
.panel.pop{animation:pop .55s cubic-bezier(.34,1.7,.5,1)}
@keyframes pop{0%{transform:scale(.88) translateY(14px);opacity:0}100%{transform:none;opacity:1}}
.dhead{display:flex;gap:10px;align-items:center;margin-bottom:10px}
.dhead svg{width:84px;flex:none;border:3px solid var(--ink);border-radius:20px;background:var(--sea)}
.dhead h3{font-size:18px;line-height:1.35}
.tl{list-style:none;margin:0;padding:0 0 0 18px;border-left:3px solid var(--ink)}
.tl li{position:relative;padding:0 0 14px 14px}
.tl li::before{content:"";position:absolute;left:-28px;top:6px;width:14px;height:14px;border-radius:50%;background:var(--coral);border:3px solid var(--ink)}
.tl li.m::before{background:var(--sun)}
.tl .tm{font-size:13px}.tl .tt{font-size:16px}.tl .ds{font-size:14px}
.meal{border:3px dashed var(--ink);border-radius:18px;padding:8px 12px;margin-top:6px;font-size:14px;background:var(--green)}
.list{list-style:none;margin:0;padding:0}
.list li{margin:0}
.list label{display:flex;gap:10px;align-items:flex-start;padding:7px 0;cursor:pointer;font-size:15px}
.list input{appearance:none;-webkit-appearance:none;flex:none;width:24px;height:24px;margin:1px 0 0;border:3px solid var(--ink);border-radius:8px;background:var(--paper);display:grid;place-items:center;cursor:pointer}
.list input:checked{background:var(--green)}
.list input:checked::after{content:"✓";font-size:16px;line-height:1}
.list input:checked+span{text-decoration:line-through;opacity:.55}
.prog{height:14px;border:3px solid var(--ink);border-radius:999px;margin-bottom:8px;overflow:hidden;background:var(--paper)}
.prog i{display:block;height:100%;width:0;background:var(--coral);transition:width .4s cubic-bezier(.34,1.5,.5,1)}
.grp{margin-top:12px}.grp h3{font-size:16px;margin-bottom:2px}
.hotel{background:var(--green)}
.hotel p{font-size:15px}
footer{text-align:center;font-size:13px;margin-top:32px}
.sunr{transform-box:fill-box;transform-origin:center;animation:pulse 4s ease-in-out infinite}
.c1{animation:drift 46s linear infinite}.c2{animation:drift 62s linear infinite;animation-delay:-30s}
.plane{animation:fly 16s linear infinite}.bob{animation:ibob 3s ease-in-out infinite}
.car{animation:drive 9s linear infinite}
.wA{animation:flow 5s linear infinite}.wB{animation:flow 8s linear infinite reverse}
.boat{transform-box:fill-box;transform-origin:50% 100%;animation:rock 4s ease-in-out infinite}
.ibob{animation:ibob 3s ease-in-out infinite}.icar{animation:idrive 4s linear infinite}
.irock{transform-box:fill-box;transform-origin:50% 100%;animation:rock 4s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(1.12)}}
@keyframes drift{from{transform:translateX(-70px)}to{transform:translateX(400px)}}
@keyframes fly{from{transform:translateX(-80px)}to{transform:translateX(430px)}}
@keyframes ibob{50%{transform:translateY(-4px)}}
@keyframes drive{from{transform:translateX(0)}to{transform:translateX(150px)}}
@keyframes idrive{from{transform:translateX(0)}to{transform:translateX(52px)}}
@keyframes flow{to{transform:translateX(60px)}}
@keyframes rock{0%,100%{transform:rotate(-3deg) translateY(0)}50%{transform:rotate(3deg) translateY(-3px)}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
