main{max-width:560px;margin:0 auto;padding:64px 16px 40px}
section{margin-top:28px}
h1,h2,h3,p{margin:0}
h2{font-size:22px;margin-bottom:12px;display:inline-block;background:var(--sun);border:3px solid var(--ink);border-radius:999px;padding:0 16px}
.card{background:var(--paper);border:3px solid var(--ink);border-radius:28px;padding:16px}
.hero{text-align:center;background:var(--sea);padding:12px 12px 20px;overflow:hidden}
.hero svg{width:100%;height:auto;display:block}
.hero h1{font-size:28px;line-height:1.3;margin-top:8px}
.hero p{font-size:14px}
.count{display:flex;gap:8px;justify-content:center;margin-top:12px}
.count div{background:var(--paper);border:3px solid var(--ink);border-radius:18px;min-width:64px;padding:4px 6px}
.count b{display:block;font-size:26px;line-height:1.2}.count span{font-size:12px}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.facts div{border:3px solid var(--ink);border-radius:18px;padding:6px 10px;font-size:14px;background:var(--paper)}
.flight{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:center}
.flight+.flight{margin-top:12px}
.flight .c{font-size:30px;line-height:1.1}.flight small{display:block;font-size:12px}
.flight .mid{flex:1;border-top:3px dashed var(--ink);position:relative;height:0}
