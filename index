nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:30;background:var(--paper);border-bottom:3px solid var(--ink);display:flex;gap:8px;overflow-x:auto;padding:8px 12px}
nav button{flex:none;font:inherit;font-size:14px;color:var(--ink);background:var(--paper);border:3px solid var(--ink);border-radius:999px;padding:2px 12px;cursor:pointer}
